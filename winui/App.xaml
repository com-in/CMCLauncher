<Application x:Class="CraftLauncher.WinUI.CraftApp" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:Microsoft.UI.Xaml.Controls">
  <Application.Resources>
    <ResourceDictionary>
      <!-- 先加载 WinUI 默认控件资源，下面再补充应用的主题色和样式。 -->
      <ResourceDictionary.MergedDictionaries><controls:XamlControlsResources /></ResourceDictionary.MergedDictionaries>
      <!-- 这些资源随 RequestedTheme 切换，代码创建的配色画刷另由 ApplyTheme 更新。 -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#416D37"/>
          <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#30592B"/>
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#DDE8D6"/>
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#D4E1CB"/>
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#CBD9C0"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="NavigationViewSelectionIndicatorForeground" Color="#536DBD"/>
          <SolidColorBrush x:Key="NavigationViewItemForegroundSelected" Color="#91A9F0"/>
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelected" Color="#2C3550"/>
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPointerOver" Color="#354260"/>
          <SolidColorBrush x:Key="NavigationViewItemBackgroundSelectedPressed" Color="#3F4F75"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
      <Style TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden"/>
      </Style>
      <Style TargetType="ScrollBar"><Setter Property="Visibility" Value="Collapsed"/></Style>
      <Style TargetType="TextBox">
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
      </Style>
      <Style TargetType="NavigationViewItem">
        <Setter Property="MinHeight" Value="34"/><Setter Property="Height" Value="36"/>
        <Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,2,0,2"/>
        <Setter Property="CornerRadius" Value="4"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
