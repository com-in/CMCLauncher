<ResourceDictionary
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <!-- 此字典声明按钮和导航项样式；是否生效取决于资源引用处是否合并了它。 -->
  <Style TargetType="Button">
    <Setter
      Property="CornerRadius"
      Value="7"
    />
    <Setter
      Property="Padding"
      Value="14,9"
    />
    <Setter
      Property="Margin"
      Value="0,0,8,0"
    />
  </Style>
  <Style TargetType="NavigationViewItem">
    <Setter
      Property="Margin"
      Value="0,3,0,3"
    />
    <Setter
      Property="CornerRadius"
      Value="7"
    />
  </Style>
  <Style
    x:Key="AccentButtonStyle"
    TargetType="Button"
  >
    <Setter
      Property="Background"
      Value="#406C32"
    />
    <Setter
      Property="Foreground"
      Value="White"
    />
  </Style>
</ResourceDictionary>
