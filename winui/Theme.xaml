<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="Button">
    <Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/>
  </Style>
  <Style TargetType="NavigationViewItem">
    <Setter Property="Margin" Value="0,3,0,3"/><Setter Property="CornerRadius" Value="7"/>
  </Style>
  <Style x:Key="AccentButtonStyle" TargetType="Button">
    <Setter Property="Background" Value="#406C32"/><Setter Property="Foreground" Value="White"/>
  </Style>
</ResourceDictionary>
