<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AssemblyName>CMCLauncher</AssemblyName>
    <Product>CMCLauncher</Product>
    <Title>CMCLauncher</Title>
    <RootNamespace>CMCLauncher.WinUI</RootNamespace>
    <Version>1.0.0</Version>
    <CurseForgeConfigurationFile
      Condition="'$(CurseForgeConfigurationFile)' == ''"
    >$(MSBuildProjectDirectory)/curseforge.local.json</CurseForgeConfigurationFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/cmc-logo.ico</ApplicationIcon>
    <!-- 使用 Program.cs 中的自定义入口，负责 OLE 初始化和资源准备。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling Condition="'$(PublishSingleFile)' == 'true'">true</EnableMsixTooling>
    <!-- 构建时自动填写构建时间/版本/提交，About 页读取展示。构建提交号由 _GenerateLauncherBuildInfo 在编译时读取 Git 填充。 -->
    <LauncherBuildTime>$([System.DateTime]::UtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'"))</LauncherBuildTime>
    <LauncherGitCommit>
    </LauncherGitCommit>
    <IncludeNativeLibrariesForSelfExtract
      Condition="'$(PublishSingleFile)' == 'true'"
    >true</IncludeNativeLibrariesForSelfExtract>
    <DefineConstants
      Condition="'$(PublishSingleFile)' == 'true'"
    >$(DefineConstants);SINGLE_FILE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../native/LauncherInstanceFormat.cs" Link="Core/LauncherInstanceFormat.cs" />
    <Compile Include="../native/LocalInstanceDiscovery.cs" Link="Core/LocalInstanceDiscovery.cs" />
    <Compile Include="../native/LauncherUpdates.cs" Link="Core/LauncherUpdates.cs" />
    <Compile Include="../native/LauncherUpdateInstaller.cs" Link="Core/LauncherUpdateInstaller.cs" />
    <EmbeddedResource Include="../native/LauncherUpdateWorker.ps1" LogicalName="CMCLauncher.UpdateWorker" />
  </ItemGroup>
  <!-- Partial trimming keeps the application and third-party libraries intact. -->
  <ItemGroup Condition="'$(PublishSingleFile)' != 'true'">
    <Compile Remove="CompanionData.g.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">true</PublishTrimmed>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimMode>partial</TrimMode>
    <!-- Settings, API models and shell operations still use reflection and COM. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>
  <!-- Preserve reflection metadata and WinRT projections; trim only safe framework code. -->
  <ItemGroup Condition="'$(PublishTrimmed)' == 'true'">
    <TrimmerRootAssembly Include="$(AssemblyName)" />
    <TrimmerRootAssembly Include="Microsoft.Windows.SDK.NET" />
    <TrimmerRootAssembly Include="Microsoft.WinUI" />
    <TrimmerRootAssembly Include="WinRT.Runtime" />
    <TrimmerRootAssembly Include="Microsoft.InteractiveExperiences.Projection" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="themes/craft.json"
      LogicalName="CMCLauncher.Themes.craft.json"
    />
    <Content
      Include="themes/*.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Compile
      Include="../native/ThemeCatalog.cs"
      Link="Core/ThemeCatalog.cs"
    />

    <Content
      Include="locales/*.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <EmbeddedResource
      Include="locales/*.json"
      LogicalName="CMCLauncher.Locales.%(Filename).json"
    />
    <Compile
      Include="../native/LocalizationCatalog.cs"
      Link="Core/LocalizationCatalog.cs"
    />
    <EmbeddedResource
      Include="clientid.local.json"
      LogicalName="CMCLauncher.MicrosoftClient"
      Condition="Exists('clientid.local.json')"
    />
    <Content
      Update="assets/cmc-logo.png"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Content
      Update="assets/grass-block.png"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Content
      Include="assets/loaders/*.png"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <None
      Update="assets/cmc-logo.ico"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <PackageReference
      Include="Markdig"
      Version="1.4.2"
    />
    <!-- Component packages keep unused AI, ML and Widgets runtimes out of portable releases. -->
    <PackageReference
      Include="Microsoft.WindowsAppSDK.WinUI"
      Version="1.8.260803003"
    />
    <PackageReference
      Include="Microsoft.WindowsAppSDK.DWrite"
      Version="1.8.25122902"
    />
    <!-- 核心源码直接编入桌面程序集，认证资源也随当前程序集一起读取。 -->
    <Compile
      Include="../native/Models.cs"
      Link="Core/Models.cs"
    />
    <Compile
      Include="../native/LogTail.cs"
      Link="Core/LogTail.cs"
    />
    <Compile
      Include="../native/GameMemory.cs"
      Link="Core/GameMemory.cs"
    />
    <Compile
      Include="../native/JavaManager.cs"
      Link="Core/JavaManager.cs"
    />
    <Compile
      Include="../native/WorldArchive.cs"
      Link="Core/WorldArchive.cs"
    />
    <Compile
      Include="../native/LauncherCore.cs"
      Link="Core/LauncherCore.cs"
    />
    <Compile
      Include="../native/LauncherLibraries.cs"
      Link="Core/LauncherLibraries.cs"
    />
    <Compile
      Include="../native/NativeDirectoryLease.cs"
      Link="Core/NativeDirectoryLease.cs"
    />
    <Compile
      Include="../native/CertificatePolicy.cs"
      Link="Core/CertificatePolicy.cs"
    />
    <Compile
      Include="../native/SchematicManager.cs"
      Link="Core/SchematicManager.cs"
    />
    <Compile
      Include="../native/FrpcManager.cs"
      Link="Core/FrpcManager.cs"
    />
    <Compile
      Include="../native/FrpcConfigurations.cs"
      Link="Core/FrpcConfigurations.cs"
    />
    <Compile
      Include="../native/ContentManager.cs"
      Link="Core/ContentManager.cs"
    />
    <Compile
      Include="../native/ModrinthService.cs"
      Link="Core/ModrinthService.cs"
    />
    <Compile
      Include="../native/CommunityService.cs"
      Link="Core/CommunityService.cs"
    />
    <Compile
      Include="../native/CurseForgeCommunityService.cs"
      Link="Core/CurseForgeCommunityService.cs"
    />
    <EmbeddedResource
      Include="$(CurseForgeConfigurationFile)"
      LogicalName="CMCLauncher.CurseForgeApi"
      Condition="Exists('$(CurseForgeConfigurationFile)')"
    />
    <Compile
      Include="../native/CurseForgeCredentials.cs"
      Link="Core/CurseForgeCredentials.cs"
    />
    <Compile
      Include="../native/CurseForgeService.cs"
      Link="Core/CurseForgeService.cs"
    />
    <Compile
      Include="../native/CurseForgeClient.cs"
      Link="Core/CurseForgeClient.cs"
    />
    <Compile
      Include="../native/MicrosoftAuth.cs"
      Link="Core/MicrosoftAuth.cs"
    />
    <Compile
      Include="../native/ExternalAuth.cs"
      Link="Core/ExternalAuth.cs"
    />
    <Compile
      Include="../native/GlobalUsings.cs"
      Link="Core/GlobalUsings.cs"
    />
  </ItemGroup>
  <!-- 构建时生成构建信息源码，About 页自动展示构建时间/版本/提交。 -->
  <ItemGroup>
    <Compile Include="$(IntermediateOutputPath)LauncherBuildInfo.g.cs" />
  </ItemGroup>
  <Target
    Name="_GenerateLauncherBuildInfo"
    BeforeTargets="PrepareForBuild;CoreCompile"
  >
    <PropertyGroup>
      <LauncherBuildInfoFile>$(IntermediateOutputPath)LauncherBuildInfo.g.cs</LauncherBuildInfoFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <!-- 编译时读取当前 Git 提交号，构建信息页展示真实提交。git 不可用时回退到默认值。 -->
    <PropertyGroup
      Condition="'$(LauncherGitCommitOverride)' != ''"
    >
      <LauncherGitCommit>$(LauncherGitCommitOverride)</LauncherGitCommit>
    </PropertyGroup>
    <Exec
      Condition="'$(LauncherGitCommit)' == ''"
      Command="git rev-parse --short HEAD"
      ConsoleToMsBuild="true"
      EchoOff="true"
      IgnoreExitCode="true"
    >
      <Output
        TaskParameter="ConsoleOutput"
        PropertyName="GitShortCommit"
      />
    </Exec>
    <PropertyGroup Condition="'$(LauncherGitCommit)' == ''">
      <LauncherGitCommit
        Condition="'$(GitShortCommit)' != ''"
      >$(GitShortCommit)</LauncherGitCommit>
      <LauncherGitCommit Condition="'$(LauncherGitCommit)' == ''">unknown</LauncherGitCommit>
    </PropertyGroup>
    <!-- 逐行生成 C#，用 %3B 转义分号，避免 XML 属性换行规范化和 item 分号拆分导致代码损坏。 -->
    <ItemGroup>
      <BuildInfoLine Include="#pragma warning disable CS1591" />
      <BuildInfoLine Include="// 本文件由 MSBuild 在编译前自动生成，请勿手动修改。" />
      <BuildInfoLine Include="namespace CMCLauncher.WinUI%3B" />
      <BuildInfoLine Include="     " />
      <BuildInfoLine Include="internal static partial class LauncherBuildInfo" />
      <BuildInfoLine Include="{" />
      <BuildInfoLine Include="    public const string Version = &quot;$(Version)&quot;%3B" />
      <BuildInfoLine Include="    public const string BuildTime = &quot;$(LauncherBuildTime)&quot;%3B" />
      <BuildInfoLine Include="    public const string GitCommit = &quot;$(LauncherGitCommit)&quot;%3B" />
      <BuildInfoLine Include="}" />
      <BuildInfoLine Include="     " />
    </ItemGroup>
    <WriteLinesToFile
      File="$(LauncherBuildInfoFile)"
      Overwrite="true"
      Encoding="UTF-8"
      Lines="@(BuildInfoLine)"
    />
  </Target>
  <!-- Filter before copying or bundling, so single-file releases cannot retain unused MUI files. -->
  <Target
    Name="FilterWinUIMuiLanguages"
    AfterTargets="ComputeResolvedFilesToPublishList"
    BeforeTargets="_ComputeFilesToBundle"
  >
    <ItemGroup>
      <LauncherMuiLanguage Include="$(MSBuildProjectDirectory)/locales/*.json" />
    </ItemGroup>
    <PropertyGroup>
      <LauncherMuiCultureNames>@(LauncherMuiLanguage->'%(Filename)', '|')</LauncherMuiCultureNames>
      <LauncherMuiCulturePattern
      >(?i)^(en-us|$([System.String]::Copy('$(LauncherMuiCultureNames)').Replace('_', '-')))[\\/]</LauncherMuiCulturePattern>
    </PropertyGroup>
    <ItemGroup>
      <UnsupportedMui
        Include="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.mui' and $([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})+[\\/]')) and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '$(LauncherMuiCulturePattern)'))"
      />
      <ResolvedFileToPublish Remove="@(UnsupportedMui)" />
    </ItemGroup>
    <Message
      Importance="high"
      Text="Excluded @(UnsupportedMui->Count()) unsupported WinUI MUI files from publishing."
    />
  </Target>
  <!-- Windows paths are case-insensitive; avoid duplicate SDK asset entries in single-file bundles. -->
  <Target
    Name="DeduplicateSingleFileInputs"
    BeforeTargets="GenerateSingleFileBundle"
    DependsOnTargets="_ComputeFilesToBundle"
    Condition="'$(PublishSingleFile)' == 'true'"
  >
    <RemoveDuplicates Inputs="@(FilesToBundle)">
      <Output
        TaskParameter="Filtered"
        ItemName="UniqueFilesToBundle"
      />
    </RemoveDuplicates>
    <ItemGroup>
      <FilesToBundle Remove="@(FilesToBundle)" />
      <FilesToBundle Include="@(UniqueFilesToBundle)" />
    </ItemGroup>
  </Target>
  <!-- 普通发布复制外部 WinUI 资源；单文件发布由伴生数据释放资源。 -->
  <Target
    Name="PublishWinUIResources"
    AfterTargets="Publish"
    Condition="'$(PublishSingleFile)' != 'true'"
  >
    <ItemGroup>
      <WinUIResource Include="$(TargetDir)*.pri;$(TargetDir)*.xbf" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WinUIResource)"
      DestinationFolder="$(PublishDir)"
    />
    <Exec
      WorkingDirectory="$(PublishDir)"
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\organize-winui-languages.ps1&quot; -PublishDir ."
    />
  </Target>
</Project>