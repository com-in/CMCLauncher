<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsAppSdkBootstrapInitialize>false</WindowsAppSdkBootstrapInitialize>
    <WindowsAppSdkDeploymentManagerInitialize>false</WindowsAppSdkDeploymentManagerInitialize>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AssemblyName>CMCLauncher</AssemblyName>
    <Product>CMCLauncher</Product>
    <Title>CMCLauncher</Title>
    <RootNamespace>CMCLauncher.WinUI</RootNamespace>
    <Version>0.9.4</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets/cmc-logo.ico</ApplicationIcon>
    <!-- 使用 Program.cs 中的自定义入口，负责 OLE 初始化和资源准备。 -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <EnableMsixTooling Condition="'$(PublishSingleFile)' == 'true'">true</EnableMsixTooling>
    <IncludeNativeLibrariesForSelfExtract
      Condition="'$(PublishSingleFile)' == 'true'"
    >true</IncludeNativeLibrariesForSelfExtract>
    <DefineConstants
      Condition="'$(PublishSingleFile)' == 'true'"
    >$(DefineConstants);SINGLE_FILE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource
      Include="themes/craft.json"
      LogicalName="CMCLauncher.Themes.craft.json"
    />
    <Content
      Include="themes/*.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Compile
      Include="../native/ThemeCatalog.cs"
      Link="Core/ThemeCatalog.cs"
    />

    <Content
      Include="locales/*.json"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <EmbeddedResource
      Include="locales/*.json"
      LogicalName="CMCLauncher.Locales.%(Filename).json"
    />
    <Compile
      Include="../native/LocalizationCatalog.cs"
      Link="Core/LocalizationCatalog.cs"
    />
    <EmbeddedResource
      Include="clientid.local.json"
      LogicalName="CMCLauncher.MicrosoftClient"
      Condition="Exists('clientid.local.json')"
    />
    <Content
      Update="assets/cmc-logo.png"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Content
      Update="assets/grass-block.png"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <Content
      Include="assets/loaders/*.png"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <None
      Update="assets/cmc-logo.ico"
      CopyToOutputDirectory="PreserveNewest"
      CopyToPublishDirectory="PreserveNewest"
    />
    <PackageReference
      Include="Markdig"
      Version="1.4.2"
    />
    <PackageReference
      Include="Microsoft.WindowsAppSDK"
      Version="1.8.260921001"
    />
    <!-- 核心源码直接编入桌面程序集，认证资源也随当前程序集一起读取。 -->
    <Compile
      Include="../native/Models.cs"
      Link="Core/Models.cs"
    />
    <Compile
      Include="../native/GameMemory.cs"
      Link="Core/GameMemory.cs"
    />
    <Compile
      Include="../native/JavaManager.cs"
      Link="Core/JavaManager.cs"
    />
    <Compile
      Include="../native/WorldArchive.cs"
      Link="Core/WorldArchive.cs"
    />
    <Compile
      Include="../native/LauncherCore.cs"
      Link="Core/LauncherCore.cs"
    />
    <Compile
      Include="../native/CertificatePolicy.cs"
      Link="Core/CertificatePolicy.cs"
    />
    <Compile
      Include="../native/SchematicManager.cs"
      Link="Core/SchematicManager.cs"
    />
    <Compile
      Include="../native/FrpcManager.cs"
      Link="Core/FrpcManager.cs"
    />
    <Compile
      Include="../native/FrpcConfigurations.cs"
      Link="Core/FrpcConfigurations.cs"
    />
    <Compile
      Include="../native/ContentManager.cs"
      Link="Core/ContentManager.cs"
    />
    <Compile
      Include="../native/ModrinthService.cs"
      Link="Core/ModrinthService.cs"
    />
    <Compile
      Include="../native/CurseForgeService.cs"
      Link="Core/CurseForgeService.cs"
    />
    <Compile
      Include="../native/CurseForgeClient.cs"
      Link="Core/CurseForgeClient.cs"
    />
    <Compile
      Include="../native/MicrosoftAuth.cs"
      Link="Core/MicrosoftAuth.cs"
    />
    <Compile
      Include="../native/GlobalUsings.cs"
      Link="Core/GlobalUsings.cs"
    />
  </ItemGroup>
  <!-- Filter before copying or bundling, so single-file releases cannot retain unused MUI files. -->
  <Target
    Name="FilterWinUIMuiLanguages"
    AfterTargets="ComputeResolvedFilesToPublishList"
    BeforeTargets="_ComputeFilesToBundle"
  >
    <ItemGroup>
      <LauncherMuiLanguage Include="$(MSBuildProjectDirectory)/locales/*.json" />
    </ItemGroup>
    <PropertyGroup>
      <LauncherMuiCultureNames>@(LauncherMuiLanguage->'%(Filename)', '|')</LauncherMuiCultureNames>
      <LauncherMuiCulturePattern
      >(?i)^(en-us|$([System.String]::Copy('$(LauncherMuiCultureNames)').Replace('_', '-')))[\\/]</LauncherMuiCulturePattern>
    </PropertyGroup>
    <ItemGroup>
      <UnsupportedMui
        Include="@(ResolvedFileToPublish)"
        Condition="'%(ResolvedFileToPublish.Extension)' == '.mui' and $([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})+[\\/]')) and !$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '$(LauncherMuiCulturePattern)'))"
      />
      <ResolvedFileToPublish Remove="@(UnsupportedMui)" />
    </ItemGroup>
    <Message
      Importance="high"
      Text="Excluded @(UnsupportedMui->Count()) unsupported WinUI MUI files from publishing."
    />
  </Target>
  <!-- Windows paths are case-insensitive; avoid duplicate SDK asset entries in single-file bundles. -->
  <Target
    Name="DeduplicateSingleFileInputs"
    BeforeTargets="GenerateSingleFileBundle"
    DependsOnTargets="_ComputeFilesToBundle"
    Condition="'$(PublishSingleFile)' == 'true'"
  >
    <RemoveDuplicates Inputs="@(FilesToBundle)">
      <Output
        TaskParameter="Filtered"
        ItemName="UniqueFilesToBundle"
      />
    </RemoveDuplicates>
    <ItemGroup>
      <FilesToBundle Remove="@(FilesToBundle)" />
      <FilesToBundle Include="@(UniqueFilesToBundle)" />
    </ItemGroup>
  </Target>
  <!-- 普通发布复制外部 WinUI 资源；单文件发布由伴生数据释放资源。 -->
  <Target
    Name="PublishWinUIResources"
    AfterTargets="Publish"
    Condition="'$(PublishSingleFile)' != 'true'"
  >
    <ItemGroup>
      <WinUIResource Include="$(TargetDir)*.pri;$(TargetDir)*.xbf" />
    </ItemGroup>
    <Copy
      SourceFiles="@(WinUIResource)"
      DestinationFolder="$(PublishDir)"
    />
    <Exec
      WorkingDirectory="$(PublishDir)"
      Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\organize-winui-languages.ps1&quot; -PublishDir ."
    />
  </Target>
</Project>
