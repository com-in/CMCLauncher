<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CraftLauncher</AssemblyName>
    <RootNamespace>CraftLauncher</RootNamespace>
    <Version>0.3.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../winui/clientid.local.json" LogicalName="CMCLauncher.MicrosoftClient" Condition="Exists('../winui/clientid.local.json')" />
  </ItemGroup>
</Project>
